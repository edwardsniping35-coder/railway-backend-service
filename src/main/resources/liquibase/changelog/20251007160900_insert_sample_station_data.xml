        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.7.xsd">

    <changeSet id="1759833705-1" author="Janith Sandaruwan">
        <comment>Insert sample data for major railway stations in Sri Lanka</comment>

        <insert tableName="station">
            <column name="name" value="Colombo Fort"/>
            <column name="code" value="FOT"/>
            <column name="address" value="Colombo 01"/>
            <column name="status" value="ACTIVE"/>
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
        </insert>

