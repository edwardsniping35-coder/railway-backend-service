<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.7.xsd">

    <changeSet id="1760117451-1" author="Janith Sandaruwan">
        <comment>Create parcel_item table and update parcel table for new logic</comment>

        <!-- Drop the old 'category' and 'price' columns from the parcel table if they exist -->
        <dropColumn tableName="parcel" columnName="category"/>
        <dropColumn tableName="parcel" columnName="price"/>
        <dropColumn tableName="parcel" columnName="weightInKg"/>

        <!-- Add new columns to the parcel table -->
        <addColumn tableName="parcel">
            <column name="train_id" type="BIGINT"/>
            <column name="total_weight_in_kg" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
        </addColumn>

        <!-- Make the processed_by_user_id column nullable -->
        <dropNotNullConstraint tableName="parcel" columnName="processed_by_user_id"/>

        <!-- Add foreign key for the train -->
        <addForeignKeyConstraint baseTableName="parcel" baseColumnNames="train_id"
                                 constraintName="fk_parcel_train"
                                 referencedTableName="train" referencedColumnNames="id"/>

        <!-- Create the new parcel_item table -->
        <createTable tableName="parcel_item">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parcel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)"/>
            <column name="weight_in_kg" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="fee" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_user_id" type="BIGINT"/>
            <column name="last_modified_user_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="parcel_item" baseColumnNames="parcel_id"
                                 constraintName="fk_parcelitem_parcel"
                                 referencedTableName="parcel" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>